{"code":[{"desc":"Pass-through wrapper abstraction used once","id":"one-caller-abstraction","regex":"function \\w+\\([^()]*\\)\\s*\\{\\s*return \\w+\\("},{"desc":"Unused fallback value or empty catch block","id":"unused-fallback","regex":"\\|\\|\\s*(null|\\{\\}|\\[\\]|\"\"|'')|catch\\s*\\([^()]*\\)\\s*\\{\\s*\\}"},{"desc":"Comment whose words restate the next code line","id":"comment-restates-code","regex":"^\\s*(//|#|\\*)\\s*[A-Za-z].*"},{"desc":"Boolean flag parameter steering behavior","id":"bool-flag-param","regex":"\\([^()]*:\\s*boolean[^()]*\\)"},{"desc":"Shipped TODO/FIXME/XXX/HACK placeholder","id":"shipped-todo","regex":"\\bTODO\\b|\\bFIXME\\b|\\bXXX\\b|\\bHACK\\b"}],"exempt_paths":["marketing/","copy/"],"fail_on":["phrase","structural","ui","code"],"openers":["Certainly,","Moreover,","Furthermore,","Additionally,","In conclusion,","In summary,"],"phrases":["in today's fast-paced","it's worth noting","not just X, but Y","it's not X, it's Y","whether you're X or Y","here's the thing","the best part:","studies show","experts agree","a testament to","marks a pivotal moment"],"structural":[{"desc":"Comma triplet 'A, B, and C'","id":"rule-of-three","regex":"\\b\\w+, \\w+, and \\w+"},{"desc":"Em dash inside a sentence","id":"em-dash-crowding","regex":"—"},{"desc":"Setup line ending in a colon reveal","id":"colon-reveal","regex":":\\s*$"},{"desc":"'not just/only X but Y' binary contrast","id":"binary-contrast","regex":"\\bnot\\s+(just|only|merely)\\b.{0,80}\\bbut\\b"},{"desc":"Throat-clearing sentence opener","id":"throat-clearing","regex":"^\\s*(it['’]s (worth noting|important to (note|remember)|safe to say|clear that)|in today['’]s|as we all know|needless to say)"},{"desc":"Profound-sounding closer","id":"fake-profound-closer","regex":"\\b(a testament to|marks a pivotal moment|the future (is|awaits|holds)|unlocks? (a|the) (future|potential)|journey (into|of|toward))"},{"desc":"Cycling grand nouns as subjects","id":"synonym-cycling","regex":"\\b(in the (realm|tapestry|landscape|symphony) of|delve into|(vibrant|intricate|rich) (tapestry|symphony|landscape|realm))"}],"ui":[{"desc":"Inter as the sole typeface","id":"inter-only-type","regex":"font[^;\\n{}]{0,40}Inter|Inter[^;\\n{}]{0,40}font"},{"desc":"Purple-to-blue gradient hero","id":"purple-blue-gradient-hero","regex":"from-(purple|violet)[^\\n\"']*to-(blue|indigo)|linear-gradient[^;\\n]*((purple|violet)[^;\\n]*(blue|indigo))"},{"desc":"Three or more identical Card uses","id":"three-identical-cards","min_count":3,"regex":"<Card[\\s>]"},{"desc":"Badge plus headline plus CTA hero stack","id":"badge-headline-cta-hero","regex":"(?=.*\\bBadge\\b)(?=.*\\b(hero|CTA)\\b).*"},{"desc":"Card opens nested on one line","id":"nested-cards-3-deep","regex":"<Card[^>\\n]*>[^<\\n]*<Card"},{"desc":"Gradient-filled metric text","id":"gradient-metric-text","regex":"bg-clip-text|text-transparent[^;\\n]*gradient|gradient[^;\\n]*text-transparent"},{"desc":"Hero metric number plus label","id":"hero-metric-number-label","regex":"\\b(hero|stat|metric)[^\\n]{0,60}\\d[\\d,._]*[kKmM%]?\\s*(users|customers|downloads|stars|revenue|requests)\\b"},{"desc":"Thin 1px generic icon strokes","id":"thin-generic-icons","regex":"stroke(-width)?[=:\\s]+[\"']?1[\"']?\\b|strokeWidth\\s*[:=]\\s*1\\b"},{"desc":"Default glassmorphism wash","id":"default-glassmorphism","regex":"backdrop-blur|bg-white/1?0|glassmorphism"}],"version":1,"warn_on":["word","opener"],"word_fail_threshold":3,"words":["delve","tapestry","landscape","vibrant","testament","beacon","realm","symphony","pivotal","crucial","leverage","utilize","seamless","robust","cutting-edge","game-changer","synergy","unleash","unlock","elevate","foster","showcase","groundbreaking","transformative","paradigm","unprecedented","empower","streamline","meticulous","intricate"]}
